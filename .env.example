# Slack: create an app at https://api.slack.com/apps, install it to your workspace,
# and grant these Bot Token Scopes: channels:history, channels:read, groups:history,
# groups:read, users:read, im:history, mpim:history, im:read, app_mentions:read,
# chat:write, reactions:write
SLACK_BOT_TOKEN=xoxb-your-token-here

# App-level token for running the live bot (slack_bot.py) over Socket Mode --
# no public URL needed. Create it under "Basic Information" > "App-Level
# Tokens" with the connections:write scope, and enable Socket Mode in your
# app's settings. Also add these bot event subscriptions: app_mention,
# message.im, message.channels, message.groups -- the last two are what let
# the bot see edits/deletes in channels (not just DMs) and keep the vector
# store from citing corrected or removed messages.
SLACK_APP_TOKEN=xapp-your-token-here

# Comma-separated channel IDs to ingest. Leave blank to ingest every public channel
# the bot has been invited to.
SLACK_CHANNEL_IDS=

# Voyage AI key used for embeddings (voyage-3.5) and reranking (below).
# Anthropic has no embeddings endpoint, so embeddings go through Voyage AI
# (Anthropic's recommended embeddings partner) instead. Get a key at
# https://dash.voyageai.com
VOYAGE_API_KEY=pa-your-key-here

# Reranker model used to reorder retrieved chunks by relevance before
# synthesis, when there are more candidates than fit the final context. A
# dedicated rerank model instead of an LLM call: much cheaper and faster.
VOYAGE_RERANK_MODEL=rerank-2.5

# Anthropic key for the Claude agent that answers questions over the ingested
# Slack history. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-opus-5

# Smaller/faster model used for the cheap classification and query-rewrite
# step -- only final answer synthesis uses the main model above. Cuts
# meaningful latency off those calls without needing Opus-level reasoning.
ANTHROPIC_FAST_MODEL=claude-haiku-4-5

# Where Chroma persists its local vector index. The actual collection used is
# this name suffixed with WORKSPACE_ID below, so multiple workspaces/clients
# can safely share one CHROMA_PERSIST_DIR without their data mixing.
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_NAME=team_knowledge

# Identifies this deployment's tenant -- run one full deployment (its own
# .env, its own SLACK_BOT_TOKEN/SLACK_APP_TOKEN for that workspace) per
# client, and give each a distinct WORKSPACE_ID (e.g. the client's Slack team
# ID, or a short slug like "acme-corp"). Every per-tenant data path -- the
# Chroma collection, ingest_state.json, conversation memory, rate-limit
# counters -- is namespaced by this, so two clients can never end up sharing
# data even if other env vars are accidentally left identical.
WORKSPACE_ID=default

# How often the ingestion worker (ingest_worker.py) polls Slack for new
# messages, in seconds. Run it as a long-lived process alongside slack_bot.py
# so new messages show up automatically instead of manually rerunning main.py.
INGEST_INTERVAL_SECONDS=300

# Per-user rate limits, so one runaway loop or one very chatty user can't run
# up an unbounded Anthropic bill. Each question is ~2-6 Claude calls, so these
# bound total spend per user, not just request count.
RATE_LIMIT_BURST_MAX=5
RATE_LIMIT_BURST_WINDOW_SECONDS=60
RATE_LIMIT_DAILY_MAX=50
